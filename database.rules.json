{
  "rules": {
    ".read": false,
    ".write": false,
    "mesas": {
      ".read": "auth != null",
      "$mesaId": {
        ".write": "auth != null && ($mesaId.matches(/^(?:[1-9]|1[0-9]|2[0-5]|5[0-9]|6[0-5])$/))",
        ".validate": "!newData.exists() || ((!newData.child('cliente').exists() || newData.child('cliente').isString()) && (!newData.child('abertura').exists() || newData.child('abertura').isNumber()))"
      }
    },
    "pedidosProducao": {
      ".read": "auth != null",
      "$pedidoId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['mesa', 'setor', 'status']) && newData.child('mesa').isNumber() && newData.child('setor').isString() && newData.child('status').isString()"
      }
    },
    "cardapio": {
      ".read": "auth != null",
      ".write": "auth != null && newData.exists()"
    },
    "vendas": {
      ".read": "auth != null",
      "$vendaId": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['mesa', 'total']) && newData.child('mesa').isNumber() && newData.child('total').isNumber() && newData.child('total').val() >= 0"
      }
    },
    "auditoria": {
      ".read": "auth != null",
      "$registroId": {
        ".write": "auth != null && newData.exists()"
      }
    },
    "cancelamentos": {
      ".read": "auth != null",
      "$cancelamentoId": {
        ".write": "auth != null && newData.exists()"
      }
    },
    "fechamentosCaixa": {
      ".read": "auth != null",
      "$fechamentoId": {
        ".write": "auth != null && newData.exists()"
      }
    },
    "configuracoes": {
      ".read": false,
      ".write": false
    }
  }
}

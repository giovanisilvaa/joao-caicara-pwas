{
  "rules": {
    ".read": false,
    ".write": false,
    "mesas": {
      ".read": "auth != null && (auth.token.email === 'adm@acesso.joaocaicara.app' || auth.token.email === 'garcom@acesso.joaocaicara.app')",
      "$mesaId": {
        ".write": "auth != null && (auth.token.email === 'adm@acesso.joaocaicara.app' || auth.token.email === 'garcom@acesso.joaocaicara.app') && $mesaId.matches(/^([1-9]|1[0-9]|2[0-5]|5[0-9]|6[0-5])$/)",
        ".validate": "!newData.exists() || ((!newData.child('cliente').exists() || newData.child('cliente').isString()) && (!newData.child('abertura').exists() || newData.child('abertura').isNumber()))"
      }
    },
    "pedidosProducao": {
      ".read": "auth != null && (auth.token.email === 'adm@acesso.joaocaicara.app' || auth.token.email === 'garcom@acesso.joaocaicara.app')",
      "$pedidoId": {
        ".write": "auth != null && (auth.token.email === 'adm@acesso.joaocaicara.app' || auth.token.email === 'garcom@acesso.joaocaicara.app')",
        ".validate": "!newData.exists() || (newData.hasChildren(['mesa', 'setor', 'status']) && newData.child('mesa').isNumber() && newData.child('setor').isString() && newData.child('status').isString())"
      }
    },
    "cardapio": {
      ".read": "auth != null && (auth.token.email === 'adm@acesso.joaocaicara.app' || auth.token.email === 'garcom@acesso.joaocaicara.app')",
      ".write": "auth != null && auth.token.email === 'adm@acesso.joaocaicara.app' && newData.exists()"
    },
    "vendas": {
      ".read": "auth != null && auth.token.email === 'adm@acesso.joaocaicara.app'",
      ".indexOn": ["sessaoCaixaId"],
      "$vendaId": {
        ".write": "auth != null && ((auth.token.email === 'adm@acesso.joaocaicara.app' && newData.exists()) || (auth.token.email === 'garcom@acesso.joaocaicara.app' && !data.exists() && newData.exists()))",
        ".validate": "newData.hasChildren(['mesa', 'total']) && newData.child('mesa').isNumber() && newData.child('total').isNumber() && newData.child('total').val() >= 0"
      }
    },
    "auditoria": {
      ".read": "auth != null && auth.token.email === 'adm@acesso.joaocaicara.app'",
      "$registroId": {
        ".write": "auth != null && (auth.token.email === 'adm@acesso.joaocaicara.app' || auth.token.email === 'garcom@acesso.joaocaicara.app') && !data.exists() && newData.exists()"
      }
    },
    "cancelamentos": {
      ".read": "auth != null && auth.token.email === 'adm@acesso.joaocaicara.app'",
      "$cancelamentoId": {
        ".write": "auth != null && auth.token.email === 'adm@acesso.joaocaicara.app' && newData.exists()"
      }
    },
    "fechamentosCaixa": {
      ".read": "auth != null && auth.token.email === 'adm@acesso.joaocaicara.app'",
      "$fechamentoId": {
        ".write": "auth != null && auth.token.email === 'adm@acesso.joaocaicara.app' && newData.exists()"
      }
    },
    "sessoesCaixa": {
      ".read": "auth != null && auth.token.email === 'adm@acesso.joaocaicara.app'",
      ".write": "auth != null && auth.token.email === 'adm@acesso.joaocaicara.app'",
      "atual": {
        ".validate": "!newData.exists() || (newData.hasChildren(['id', 'codigo', 'status', 'abertoEm', 'fundoInicial', 'origem', 'versao']) && newData.child('id').isString() && newData.child('codigo').isString() && newData.child('status').val() === 'aberto' && newData.child('abertoEm').isNumber() && newData.child('fundoInicial').isNumber() && newData.child('fundoInicial').val() >= 0 && newData.child('origem').val() === 'pdv' && newData.child('versao').val() === 1)"
      },
      "registros": {
        ".indexOn": ["fechadoEm"],
        "$sessaoId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['id', 'codigo', 'status', 'abertoEm', 'fundoInicial', 'origem', 'versao']) && newData.child('id').isString() && newData.child('id').val() === $sessaoId && newData.child('codigo').isString() && (newData.child('status').val() === 'aberto' || (newData.child('status').val() === 'fechado' && newData.hasChildren(['fechadoEm', 'duracaoMs']) && newData.child('fechadoEm').isNumber() && newData.child('duracaoMs').isNumber() && newData.child('duracaoMs').val() >= 0)) && newData.child('abertoEm').isNumber() && newData.child('fundoInicial').isNumber() && newData.child('fundoInicial').val() >= 0 && newData.child('origem').val() === 'pdv' && newData.child('versao').val() === 1)"
        }
      }
    },
    "perfisAcesso": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "configuracoes": {
      ".read": false,
      ".write": false
    }
  }
}

{
  "hosting": {
    "public": "client/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/pdv/index.html",
        "destination": "/pdv/",
        "type": 302
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
